{
  "name": "font-archive",
  "private": true,
  "version": "1.0.0",
  "description": "A bilingual, genre-curated typeface archive for film. 面向影视创作的中英双语字体档案馆。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwinZDZ/font-archive.git"
  },
  "homepage": "https://github.com/EdwinZDZ/font-archive#readme",
  "bugs": {
    "url": "https://github.com/EdwinZDZ/font-archive/issues"
  },
  "keywords": [
    "typography",
    "fonts",
    "font-archive",
    "type-specimen",
    "react",
    "vite",
    "tailwindcss",
    "bilingual",
    "字体",
    "字体档案馆"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "catalog": "node scripts/scan-fonts.mjs && node scripts/build-catalog.mjs",
    "docs:catalog": "node --experimental-strip-types scripts/build-docs.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.4.0",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
